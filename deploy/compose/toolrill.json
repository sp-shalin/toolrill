{
  "diagnostics": {
    "enabled": true,
    "level": "INFO"
  },
  "hosts": [
    {
      "name": "default",
      "incoming": {
        "transport": "streamable-http",
        "url": "http://0.0.0.0:3001"
      },
      "outgoing": [
        {
          "name": "stdio",
          "enabled": true,
          "transport": "stdio",
          "command": "dotnet",
          "projectPath": "/projects/samples/StdioServer/StdioServer.csproj"
        }
      ]
    }
  ]
}